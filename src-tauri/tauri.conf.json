{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tokentracker",
  "version": "0.3.0",
  "identifier": "com.tokentracker.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "tokentracker",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 500,
        "maximized": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgzOEVCMjM3NDMzOTA1M0YKUldRL0JUbERON0tPZzVEbThTeXJHL2ptM0U5a09iNXFSUy9mUURRa2syVjZpejZPR29zM1NOMTEK",
      "endpoints": [
        "https://github.com/SUMANTHXT900/tokentracker/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "windows": {
        "stableOnly": true
      }
    }
  }
}
